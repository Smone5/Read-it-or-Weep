# Copy to backend/.env and fill in. Every setting can also be given as a normal environment
# variable, which is how you configure the container in the cloud.

# --- Required ---------------------------------------------------------------------
# Any PostgreSQL 13+ (Azure Database for PostgreSQL, Amazon RDS, Google Cloud SQL, a container...)
DATABASE_URL=postgresql://quiz:quiz@127.0.0.1:5544/quiz
# Signs player and admin sessions. 32+ random characters, e.g.  openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Most simultaneous database connections this copy of the app may open (default 20).
# DB_POOL_MAX=20

# --- First admin (created at start-up if no admin exists yet) -------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- AI provider: openai (default) or azure -------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Azure OpenAI instead: set LLM_PROVIDER=azure and these (model names below become deployment names)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Models (defaults shown)
# MODEL_WRITER=gpt-6.2-sol            # writes questions
# MODEL_CHECKER=gpt-6.2-sol           # independently checks them
# MODEL_VISION=gpt-6.2-sol            # reads charts and pictures
# MODEL_FAST=gpt-6-luna               # hints, summaries
# MODEL_EMBEDDING=text-embedding-3-small
# MODEL_VOICE=gpt-realtime-2.1-mini   # the host with an OpenAI voice, "Standard"
# MODEL_VOICE_PREMIUM=gpt-realtime-2.1  # the host with an OpenAI voice, "Premium"
# MODEL_HOST_WRITER=gpt-6-luna        # writes the host's lines for an ElevenLabs voice (default: MODEL_FAST)
# MODEL_TRANSCRIBE=gpt-4o-mini-transcribe  # what a player says to an ElevenLabs host, as text
# MODEL_SPEECH=gpt-4o-mini-tts        # the backup voice if ElevenLabs fails during a game

# --- The host's voices: ElevenLabs (optional) ------------------------------------------------
# The host characters use ElevenLabs' game-show-host voices. Without a key, each is played by the
# closest OpenAI voice. A paid plan is needed (library voices are not available through the API on
# the free plan); Starter includes the commercial licence.
# ELEVENLABS_API_KEY=
# ELEVENLABS_ENGINE=socket            # socket: Eleven v4 Turbo, fast (default) | dialogue: Eleven v4 | tts
# ELEVENLABS_MODEL=                   # empty: the engine's own model

# --- Where uploaded reports and pictures are kept: local | s3 | azure | gcs ---------------
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=var/storage
# STORAGE_BUCKET=            # bucket (s3, gcs) or container (azure)
# STORAGE_PREFIX=read-it-or-weep
# S3_ENDPOINT_URL=           # only for S3-compatible stores such as MinIO or R2
# S3_REGION=
# AZURE_STORAGE_CONNECTION_STRING=   # or AZURE_STORAGE_ACCOUNT_URL to use a managed identity

# --- Addresses -------------------------------------------------------------------------
# The public address of the site (used for share links and QR codes).
PUBLIC_BASE_URL=http://localhost:8100
# Only needed in development, when the web app runs on its own port:
# WEB_BASE_URL=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173
# Only for scripts/share.sh (a public test link from your own computer): the fixed address ngrok
# gives your account, so the link is the same every time it is opened.
# NGROK_DOMAIN=your-name.ngrok-free.app

# --- Apple Music (optional) --------------------------------------------------------------
# Music rounds work without this (free 30-second previews). With an Apple developer key the
# song catalogue fills faster.
# APPLE_TEAM_ID=
# APPLE_MUSIC_KEY_ID=
# APPLE_MUSIC_PRIVATE_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
# APPLE_PRIVATE_KEY_B64=     # alternative to the file: the key, base64-encoded
